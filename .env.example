# Copie este arquivo para ".env" na raiz do projeto e preencha os valores reais.
# Nenhum valor real deve ser commitado — este arquivo só documenta os NOMES esperados.

# --- Servidor ---
PORT=4000
JWT_SECRET=
# URL do frontend em produção (dev local cai em fallback dentro do código, não precisa aqui)
FRONTEND_URL=
# URL pública do próprio backend — usada só pra registrar o webhook do WhatsApp na criação de
# cada instância (ver backend/src/services/whatsapp/provider.js). Em produção:
# https://schednextapi.onrender.com
BACKEND_URL=http://localhost:4000
# Domínio raiz da plataforma (usado pra CORS de subdomínio de tenant e pra verificação de
# domínio próprio do plano Enterprise). Ver backend/src/routes/dominioCustomizado.js
DOMINIO_RAIZ_PLATAFORMA=schednext.com.br

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mail transacional (Brevo, via HTTP API — ver backend/src/config/mailer.js) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SchedNext

# --- Asaas (cobrança recorrente da assinatura da PLATAFORMA — ver backend/src/services/asaas.js) ---
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# --- Groq (recursos de IA — ver backend/src/services/groq.js) ---
GROQ_API_KEY=

# --- WhatsApp via Evolution API self-hosted (ver backend/src/services/whatsapp/provider.js) ---
# Sem essas 2, o envio de WhatsApp fica simulado (só loga no console). Servidor único pra
# plataforma inteira, mas cada empresa tem sua própria instância dentro dele, gerenciada por
# backend/src/routes/whatsappInstancia.js (nome da instância fica em
# empresas.whatsapp_phone_number_id, não é mais uma env var fixa).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Admin(s) absoluto(s) (donos da plataforma) ---
# Vivem na tabela `super_admins` do Supabase, não aqui. O primeiro precisa ser inserido
# manualmente (hash bcrypt da senha); depois disso, qualquer super admin já logado pode
# criar outro (restrito a e-mail @schednext.com.br) — ver backend/src/routes/superAdmin.js.

# --- Frontend (React, precisa do prefixo REACT_APP_ pra ser embutido no build) ---
REACT_APP_API_URL=http://localhost:4000
